# Copy to .env and fill in your values. .env is gitignored.

# DuckDB file location (leave default)
DUCKDB_PATH=data/processed/kkbox.duckdb

# Optional: BigQuery upload settings (week 6)
GCP_PROJECT_ID=
BIGQUERY_DATASET=kkbox_marts
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-key.json

# Optional: Kaggle API (only needed if you don't have ~/.kaggle/kaggle.json already)
KAGGLE_USERNAME=
KAGGLE_KEY=
